{
  "name": "opencode-project-time",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only reports of how much time OpenCode agents spent on a project: plugin, skill, scripts, and report format",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "python3 -m unittest discover -s tests -v && node --test tests/command.test.mjs",
    "test:node": "node --test tests/command.test.mjs"
  },
  "files": [
    "src",
    "assets",
    "skill",
    "scripts/*.py",
    "tests/*.py",
    "tests/*.mjs",
    "examples",
    "README.md",
    "REPORT_FORMAT.md",
    "DECISIONS.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
